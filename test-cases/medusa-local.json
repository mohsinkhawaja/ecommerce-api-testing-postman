{
  "name": "Medusa v2 seeded checkout integration",
  "description": "Opt-in collection for a separately configured local Medusa v2 instance.",
  "variables": {},
  "cases": [
    {
      "id": "MD-01",
      "title": "Read seeded product",
      "path": "/store/products?limit=1&q={{productQuery}}",
      "status": 200,
      "method": "GET",
      "assertions": {
        "catalog returned item": "Array.isArray(data.products) && data.products.length === 1 && data.products[0].variants.length > 0"
      },
      "headers": {
        "x-publishable-api-key": "{{publishableKey}}"
      },
      "capture": {
        "variantId": "data.products[0].variants[0].id"
      },
      "cookieJar": false,
      "setup": [
        "const base = pm.variables.replaceIn(\"{{baseUrl}}\");",
        "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):[0-9]+$/.test(base)) {",
        "  pm.test(\"Disposable loopback Medusa target required\", () => pm.expect(false).to.equal(true));",
        "  pm.execution.skipRequest();",
        "}",
        "const required = [\"publishableKey\", \"regionId\", \"productQuery\", \"shipCity\", \"shipPostalCode\", \"shipCountry\", \"paymentProvider\"];",
        "if (required.some((key) => !String(pm.variables.get(key) ?? \"\").trim())) {",
        "  pm.test(\"Configure the seeded Medusa environment\", () => pm.expect(false).to.equal(true));",
        "  pm.execution.skipRequest();",
        "}"
      ]
    },
    {
      "id": "MD-02",
      "title": "Create cart in seeded region",
      "path": "/store/carts",
      "status": 200,
      "method": "POST",
      "assertions": {
        "cart ID": "typeof data.cart.id === \"string\""
      },
      "body": {
        "region_id": "{{regionId}}"
      },
      "headers": {
        "x-publishable-api-key": "{{publishableKey}}"
      },
      "capture": {
        "cartId": "data.cart.id"
      },
      "cookieJar": false,
      "setup": [
        "const base = pm.variables.replaceIn(\"{{baseUrl}}\");",
        "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):[0-9]+$/.test(base)) {",
        "  pm.test(\"Disposable loopback Medusa target required\", () => pm.expect(false).to.equal(true));",
        "  pm.execution.skipRequest();",
        "}",
        "const required = [\"publishableKey\", \"regionId\", \"productQuery\", \"shipCity\", \"shipPostalCode\", \"shipCountry\", \"paymentProvider\"];",
        "if (required.some((key) => !String(pm.variables.get(key) ?? \"\").trim())) {",
        "  pm.test(\"Configure the seeded Medusa environment\", () => pm.expect(false).to.equal(true));",
        "  pm.execution.skipRequest();",
        "}"
      ]
    },
    {
      "id": "MD-03",
      "title": "Add a seeded variant",
      "path": "/store/carts/{{cartId}}/line-items",
      "status": 200,
      "method": "POST",
      "assertions": {
        "line exists": "data.cart.items[0].variant_id === get(\"variantId\") && data.cart.items[0].quantity === 1"
      },
      "body": {
        "variant_id": "{{variantId}}",
        "quantity": 1
      },
      "headers": {
        "x-publishable-api-key": "{{publishableKey}}"
      },
      "capture": {
        "lineId": "data.cart.items[0].id"
      },
      "cookieJar": false,
