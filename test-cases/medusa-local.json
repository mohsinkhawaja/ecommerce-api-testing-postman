      "path": "/store/payment-collections/{{paymentCollection}}/payment-sessions",
      "status": 200,
      "method": "POST",
      "assertions": {
        "payment session exists": "Array.isArray(data.payment_collection.payment_sessions) && data.payment_collection.payment_sessions.length > 0"
