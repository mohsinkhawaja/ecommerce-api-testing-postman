      "assertions": {
        "email accepted": "data.cart.email === \"checkout@example.test\""
      },
      "body": {
        "email": "checkout@example.test",
        "shipping_address": {
          "country_code": "{{shipCountry}}",
          "address_1": "100 Test Street",
          "city": "{{shipCity}}",
          "postal_code": "{{shipPostalCode}}",
          "first_name": "Synthetic",
          "last_name": "Tester"
        },
        "billing_address": {
          "country_code": "{{shipCountry}}",
          "address_1": "100 Test Street",
          "city": "{{shipCity}}",
          "postal_code": "{{shipPostalCode}}",
          "first_name": "Synthetic",
