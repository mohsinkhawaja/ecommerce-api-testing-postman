      "title": "Complete seeded checkout",
      "path": "/store/carts/{{cartId}}/complete",
      "status": 200,
      "method": "POST",
      "assertions": {
        "order rather than cart error": "data.type === \"order\" && typeof data.order.id === \"string\""
      },
      "headers": {
