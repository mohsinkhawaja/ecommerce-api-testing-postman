      "id": "MD-04",
      "title": "Update line quantity",
      "path": "/store/carts/{{cartId}}/line-items/{{lineId}}",
      "status": 200,
      "method": "POST",
      "assertions": {
        "quantity updated": "data.cart.items.some(i => i.id === get(\"lineId\") && i.quantity === 2)"
      },
      "body": {
        "quantity": 2
      },
      "headers": {
        "x-publishable-api-key": "{{publishableKey}}"
