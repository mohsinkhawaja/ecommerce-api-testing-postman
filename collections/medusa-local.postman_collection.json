{
  "info": {
    "name": "Medusa v2 seeded checkout integration",
    "description": "Opt-in collection for a separately configured local Medusa v2 instance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "MD-01 | Read seeded product",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = pm.variables.replaceIn(\"{{baseUrl}}\");",
              "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):[0-9]+$/.test(base)) {",
              "  pm.execution.skipRequest();",
              "  throw new Error(\"Set baseUrl to the disposable localhost target without trailing slash\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "  const expectedStatus = [200];",
              "  const responseStatus = pm.response.code;",
              "  pm.test(\"MD-01 | expected HTTP status\", () => {",
              "    pm.expect(responseStatus).to.be.oneOf(expectedStatus);",
              "  });",
              "  const get = (key) => pm.variables.get(key);",
              "  let data;",
              "  try { data = pm.response.json(); } catch { data = null; }",
              "  pm.test(\"MD-01 | JSON response body\", () => {",
              "    pm.expect(data).not.to.equal(null);",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/json/i);",
              "  });",
              "  pm.test(\"MD-01 | catalog returned item\", () => {",
              "    pm.expect(Boolean(Array.isArray(data.products) && data.products.length === 1 && data.products[0].variants.length > 0)).to.equal(true);",
              "  });",
              "  if (data !== null && expectedStatus.includes(responseStatus)) {",
              "    const value = data.products[0].variants[0].id;",
              "    if (value !== undefined && value !== null) {",
              "      pm.collectionVariables.set(\"variantId\", value);",
              "    }",
              "  }",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-publishable-api-key",
            "value": "{{publishableKey}}"
          }
        ],
        "url": "{{baseUrl}}/store/products?limit=1&q={{productQuery}}"
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
